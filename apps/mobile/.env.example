# Copy to apps/mobile/.env and fill in. Never commit .env.
# Expo reads this file from apps/mobile. Restart Expo after changing it.
# EXPO_PUBLIC_* values are built into the app, so never put secrets here.

# API on your PC: http://<your PC's Wi-Fi IPv4 address from ipconfig>:3000
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Development stand-in for sign-in (sample technician). Removed in P1 task 7.
EXPO_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# Work order to open (from test-data/sample-site.json)
EXPO_PUBLIC_WORK_ORDER=SAMPLE-0001
